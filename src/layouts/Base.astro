---
import '../styles/global.css';
import { isCurrent } from '../lib/nav';
import { ANALYTICS_TOKEN, SITE_NAME, SITE_URL } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	// Let the page content fill the space between header and footer (the globe).
	fill?: boolean;
	// A page that should stay out of search results, such as the 404 page.
	noindex?: boolean;
	// Structured data for search engines, written into the page as JSON-LD.
	jsonLd?: object[];
	// The social-share picture's path, and what it shows. Defaults to the site's.
	image?: { path: string; alt: string };
}
const { title, description = 'Where and how you can fly a recreational drone, country by country.', fill = false, noindex = false, jsonLd = [], image: shareImage } = Astro.props;
const links = [
	{ href: '/', label: 'Map' },
	{ href: '/countries/', label: 'Countries' },
	{ href: '/trip/', label: 'Trip' },
];
const { pathname } = Astro.url;
// The home page's title already says what the site is; every other page ends with the site name.
const fullTitle = pathname === '/' ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(pathname, SITE_URL).href;
const image = new URL(shareImage?.path ?? '/og-image.png', SITE_URL).href;
const imageAlt = shareImage?.alt ?? 'A globe over Europe and Africa with a small amber drone, next to the words Recreational Drones.';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0e1a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)" />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<title>{fullTitle}</title>
		<!-- Applies a chosen theme before the page paints, so it does not flash the other one first. -->
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		{jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replaceAll('<', '\\u003c')} />)}
		{ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>}
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header>
			<a class="brand" href="/">Recreational Drones</a>
			<nav>
				{links.map((l) => <a href={l.href} aria-current={isCurrent(pathname, l.href) ? 'page' : undefined}>{l.label}</a>)}
			</nav>
			<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to light mode">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path class="moon" d="M20 14.5A8 8 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" />
					<g class="sun"><circle cx="12" cy="12" r="4" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></g>
				</svg>
			</button>
		</header>
		<main id="main" class:list={{ fill }}>
			<slot />
		</main>
		<footer>
			<details>
				<summary>Guidance only, not legal advice.</summary>
				<p>Rules change; always verify with the official source linked on each country page before you fly.</p>
			</details>
			<nav aria-label="Footer">
				<a href="/privacy/" aria-current={isCurrent(pathname, '/privacy/') ? 'page' : undefined}>Privacy</a>
				<a href="/contact/" aria-current={isCurrent(pathname, '/contact/') ? 'page' : undefined}>Contact</a>
			</nav>
		</footer>
	</body>
</html>

<script>
	import { nextTheme, themeLabel, type Theme } from '../lib/theme';

	const button = document.getElementById('theme-toggle') as HTMLButtonElement;
	const system = matchMedia('(prefers-color-scheme: light)');
	const current = (): Theme => (document.documentElement.dataset.theme as Theme | undefined) ?? (system.matches ? 'light' : 'dark');
	const show = () => {
		button.setAttribute('aria-label', themeLabel(current()));
		button.dataset.theme = current();
	};
	button.addEventListener('click', () => {
		const theme = nextTheme(current());
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {}
		// The browser's own toolbar color follows the page.
		const bg = getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim();
		for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.setAttribute('content', bg);
		show();
	});
	system.addEventListener('change', show);
	show();
</script>

<style>
	/* Off screen until a keyboard user tabs to it, then the first thing they see. */
	.skip {
		position: absolute;
		left: var(--space-2);
		top: var(--space-2);
		z-index: 10;
		padding: var(--space-2) var(--space-3);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-radius: var(--radius);
		font-weight: 700;
		transform: translateY(-200%);
	}
	.skip:focus {
		transform: none;
	}
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) max(var(--space-3), env(safe-area-inset-right)) var(--space-2) max(var(--space-3), env(safe-area-inset-left));
		padding-top: max(var(--space-2), env(safe-area-inset-top));
	}
	.brand {
		color: var(--color-text);
		font-weight: 700;
		font-size: var(--text-lg);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	/* Padding makes each link a comfortable touch target (44px). */
	nav a {
		color: var(--color-text-muted);
		display: inline-block;
		padding: var(--space-2) var(--space-2);
		margin-left: var(--space-1);
		border-radius: var(--radius-pill);
		transition: background-color 0.15s;
	}
	nav a:hover {
		background: var(--color-surface-raised);
	}
	nav a:active {
		background: var(--color-border);
	}
	/* The page you are on: bolder and in body text color, so it is not marked by color alone. */
	nav a[aria-current='page'] {
		color: var(--color-text);
		font-weight: 700;
	}
	header nav {
		margin-left: auto;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		transition: background-color 0.15s, transform 0.15s;
	}
	.theme-toggle:hover {
		background: var(--color-surface-raised);
	}
	.theme-toggle svg {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* The icon shows what a press switches to: the sun while it is dark, the moon while it is light. */
	.theme-toggle[data-theme='light'] .sun,
	.theme-toggle:not([data-theme='light']) .moon {
		display: none;
	}
	main.fill {
		display: flex;
		flex-direction: column;
	}
	footer {
		padding: var(--space-2) max(var(--space-3), env(safe-area-inset-right)) max(var(--space-2), env(safe-area-inset-bottom)) max(var(--space-3), env(safe-area-inset-left));
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-1) var(--space-3);
	}
	footer details {
		max-width: 65ch;
	}
	footer summary {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		cursor: pointer;
	}
	footer p {
		margin: 0 0 var(--space-2);
	}
	footer nav a {
		margin-left: 0;
		margin-right: var(--space-1);
	}
</style>
