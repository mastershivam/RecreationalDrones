---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readFileSync, readdirSync } from 'node:fs';
import { guideSummaries } from '../lib/guides';
import { mainlandBounds } from '../lib/country-bounds';
import { LEVELS } from '../lib/restrictiveness';
import { ZONE_GROUPS, zoneCountriesFromFiles } from '../lib/zones';

const countries = await getCollection('countries');
// iso3 -> key facts for the hover preview, read by the map script below.
const guides = guideSummaries(countries);
// Where each guided country is, so searching for it can fly the globe there.
const bounds = mainlandBounds(JSON.parse(readFileSync('public/data/countries.geojson', 'utf8')).features, Object.keys(guides));
// The countries that have zone files; the map fetches each one's zones when it reaches that country.
const zoneCountries = zoneCountriesFromFiles(readdirSync('data/zones').filter((f) => f.endsWith('.geojson')));
---

<Base title="Recreational Drones: drone rules by country, on a map" description="Search a country or spin the globe to see how strict its drone rules are, how to register, and where to check before you fly." fill>
	<div class="stage">
		<div class="space" aria-hidden="true"><div class="stars far"></div><div class="stars mid"></div><div class="stars near"></div></div>
		<div id="map" data-guides={JSON.stringify(guides)} data-bounds={JSON.stringify(bounds)} data-zone-countries={JSON.stringify(zoneCountries)}></div>
		<div class="top">
			<div class="intro">
				<h1>Where can you fly?</h1>
				<p class="hint">Search a country, spin the globe, or tap a glowing country.</p>
				<p class="legend">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M13 2.5a7.5 7.5 0 1 0 4.5 13.4A8.5 8.5 0 0 1 13 2.5z" /></svg>
					Shaded areas are in night right now.
				</p>
			</div>
			<form class="search" role="search" autocomplete="off">
				<label class="visually-hidden" for="country-search">Search for a country</label>
				<input id="country-search" type="search" placeholder="Search for a country" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
				<kbd class="kbd" aria-hidden="true">/</kbd>
				<button type="button" id="locate" aria-label="Near me: use my location" title="Use my location. It stays in your browser and is never sent anywhere.">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="1.5" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /></svg>
					<span class="locate-label" aria-hidden="true">Near me</span>
				</button>
				<ul id="search-results" role="listbox" aria-label="Matching countries" hidden></ul>
			</form>
			<ul class="chips" id="chips" aria-label="Recent and popular countries"></ul>
			<p class="locate-status card" id="locate-status" role="status" hidden></p>
			<noscript><p class="locate-status card">The map needs JavaScript. <a href="/countries/">Browse every country</a> instead.</p></noscript>
		</div>
		<button type="button" id="rotate" class="rotate" aria-pressed="false" aria-label="Auto-rotate the globe" title="Auto-rotate the globe">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9" /><path d="M20 4v5h-5" /></svg>
		</button>
		<div class="panels">
			<div class="key-bar" id="key" role="group" aria-label="Key: how strict are the rules?">
				<p class="key-definition card" id="key-definition" role="status" hidden></p>
				<ul class="key-chips">
					{
						LEVELS.map((l) => (
							<li>
								<button type="button" class="key-chip" aria-pressed="false" data-text={l.criteria}>
									<span class="chip" style={`background: var(--color-level-${l.level})`} aria-hidden="true" />{l.label}
								</button>
							</li>
						))
					}
					<li>
						<button type="button" class="key-chip" aria-pressed="false" data-text="No guide yet. Not covered, which does not mean unrestricted.">
							<span class="chip uncovered-chip" aria-hidden="true" />Not covered yet
						</button>
					</li>
				</ul>
			</div>
			<details class="layers card" id="layers">
				<summary>Zones</summary>
				<p class="muted">Zoom in close to see them. A zone says what a place is and who says so; check the source before you fly.</p>
				<fieldset>
					<legend class="visually-hidden">Show on the map</legend>
					{
						ZONE_GROUPS.map((g) => (
							<label>
								<input type="checkbox" name="zone-group" value={g.id} checked />
								<svg class={`key ${g.id}`} viewBox="0 0 20 20" aria-hidden="true">
									{g.id === 'airport' && <circle cx="10" cy="10" r="8" />}
									{g.id === 'approval' && <rect x="2" y="3" width="16" height="14" />}
									{g.id === 'site' && <circle cx="10" cy="10" r="5" />}
								</svg>
								{g.label}
							</label>
						))
					}
				</fieldset>
				<p class="muted" id="zones-status" role="status"></p>
			</details>
		</div>
	</div>

	<!-- The large popup: opened by clicking a country or searching for one, and filled with its summary. -->
	<dialog id="country-dialog" aria-label="Country guide">
		<div class="dialog-panel">
			<div class="sheet-handle" aria-hidden="true"></div>
			<button type="button" class="dialog-close" aria-label="Close">×</button>
			<div class="dialog-body"></div>
		</div>
	</dialog>

</Base>

<script>
	import { Map, Marker, Popup, addProtocol, setWorkerUrl, type GeoJSONSource } from 'maplibre-gl';
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import { Protocol } from 'pmtiles';
	import { coveredCountryCode, initialZoom, minZoom, readMapColors, tapBox } from '../lib/map-config';
	import type { GuideSummary } from '../lib/guides';
	import { buildStyle } from '../lib/map-style';
	import { popupHtml, summaryHtml } from '../lib/popup';
	import { searchCountries } from '../lib/search';
	import { chipCountries, pushRecent } from '../lib/recent';
	import { changedSince, markSeen, parseSaved, toggleSaved, type Saved } from '../lib/saved';
	import { weightAnswer } from '../lib/weight';
	import { countryFromSearch, searchWithCountry } from '../lib/deeplink';
	import { countryAt, locateErrorMessage, locatedMessage } from '../lib/geo';
	import type { Bounds } from '../lib/country-bounds';
	import { nightGeoJSON } from '../lib/daynight';
	import { ZONE_LAYER_IDS, ZONE_MIN_ZOOM, enabledKinds, zoneCountriesInView, zoneLayerFilters, zonesPopupHtml, zoneFeatures, zonesUrl, type ZoneProps } from '../lib/zones';
	import { COUNTRIES_URL } from '../lib/map-style';
	import { weatherBlockHtml, weatherErrorMessage, weatherHtml, weatherPath, type Weather } from '../lib/weather';

	// MapLibre looks for its worker next to its own module, which breaks once bundled.
	setWorkerUrl(workerUrl);
	// Lets MapLibre read tiles straight out of the single .pmtiles file with HTTP byte ranges.
	addProtocol('pmtiles', new Protocol().tile);

	const el = document.getElementById('map')!;
	const guides: Record<string, GuideSummary> = JSON.parse(el.dataset.guides!);
	const bounds: Record<string, Bounds> = JSON.parse(el.dataset.bounds!);
	const colors = readMapColors((name) => getComputedStyle(document.documentElement).getPropertyValue(name));

	const map = new Map({
		container: el,
		style: buildStyle(colors, guides, location.origin),
		// Centred far enough north that Europe sits below the headline and search.
		center: [-4, 50],
		zoom: initialZoom(el.clientWidth, el.clientHeight),
		minZoom: minZoom(el.clientWidth, el.clientHeight),
		// The basemap tiles stop at zoom 7 in production (5 in the small test file); the map enlarges them beyond that.
		maxZoom: 8,
		// Keep the globe upright; tilting it is easy to do by accident with two fingers.
		pitchWithRotate: false,
		touchPitch: false,
	});

	// Hooks for the end-to-end tests: `data-ready` says every tile has loaded, and ?e2e exposes the map
	// so tests can find where a country is on screen.
	map.once('idle', () => (el.dataset.ready = 'true'));
	if (location.search.includes('e2e')) (window as unknown as { __map: Map }).__map = map;

	const intro = document.querySelector('.intro')!;
	map.once('dragstart', () => intro.classList.add('hidden'));

	// Slow spin of the globe, switched by the rotate button. With no saved choice it starts on its own for 20 seconds and
	// then rests; switched on by hand it keeps going. A touch, key or search on the globe switches it off. Off with
	// reduced motion and in the tests, where the globe must stay where they put it.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const rotate = document.getElementById('rotate') as HTMLButtonElement;
	let rotateChoice: string | null = null;
	try {
		rotateChoice = localStorage.getItem('autorotate');
	} catch {}
	let spinning = false;
	let spinEnds = Infinity;
	let lastFrame = 0;
	const spin = (now: number) => {
		if (!spinning) return;
		if (now > spinEnds) return setSpinning(false);
		const { lng, lat } = map.getCenter();
		// The gap is capped so a tab coming back from the background does not jump.
		map.setCenter([lng + Math.min(now - lastFrame, 50) * 0.003, lat]);
		lastFrame = now;
		requestAnimationFrame(spin);
	};
	function setSpinning(on: boolean, until = Infinity) {
		const was = spinning;
		spinning = on;
		spinEnds = until;
		rotate.setAttribute('aria-pressed', String(on));
		if (on && !was) {
			lastFrame = performance.now();
			requestAnimationFrame(spin);
		}
	}
	const stopSpin = () => setSpinning(false);
	if (!reduceMotion && rotateChoice === 'on') setSpinning(true);
	else if (!reduceMotion && rotateChoice === null && !location.search.includes('e2e')) setSpinning(true, performance.now() + 20_000);
	rotate.addEventListener('click', () => {
		const on = !spinning;
		setSpinning(on);
		try {
			localStorage.setItem('autorotate', on ? 'on' : 'off');
		} catch {}
	});
	// Taking hold of the globe stops it. (The buttons around it do not count.)
	map.on('mousedown', stopSpin);
	map.on('touchstart', stopSpin);
	map.on('wheel', stopSpin);
	document.addEventListener(
		'keydown',
		(e) => {
			// Tab moves focus and the rotate button's own keys switch it; neither should switch it off first.
			if (e.key !== 'Tab' && !(e.target as Element).closest('#rotate')) stopSpin();
		},
		{ capture: true },
	);

	// Zones are fetched one country at a time, only once the map is close enough to draw them and has reached the
	// country. If one fails, say so plainly. shortcut: a failed country is not retried until the page is reloaded.
	const zonesStatus = document.getElementById('zones-status')!;
	const zoneCountries: string[] = JSON.parse(el.dataset.zoneCountries!);
	const requested = new Set<string>();
	const zonesByCountry: Record<string, unknown[]> = {};
	let pending = 0;
	let zonesFailed = false;
	const reportZones = () => {
		el.dataset.zones = pending ? 'loading' : zonesFailed ? 'failed' : 'ready';
	};
	async function loadZones() {
		if (map.getZoom() < ZONE_MIN_ZOOM) return;
		const view = map.getBounds().toArray().flat() as [number, number, number, number];
		for (const iso3 of zoneCountriesInView(view, bounds, zoneCountries, requested)) {
			requested.add(iso3);
			pending++;
			reportZones();
			try {
				const response = await fetch(zonesUrl(iso3));
				if (!response.ok) throw new Error(String(response.status));
				zonesByCountry[iso3] = zoneFeatures(await response.json()).features;
				(map.getSource('zones') as GeoJSONSource).setData({ type: 'FeatureCollection', features: Object.values(zonesByCountry).flat() } as never);
			} catch {
				zonesStatus.textContent = 'Zones could not be loaded. The map still works.';
				zonesFailed = true;
			}
			pending--;
			// Ready once the map has drawn what arrived.
			map.once('idle', reportZones);
			if (pending === 0 && zonesFailed) reportZones();
		}
	}
	map.on('moveend', loadZones);
	map.once('load', loadZones);

	// The zone filter is a small closed tab on a phone and open on a desktop.
	(document.getElementById('layers') as HTMLDetailsElement).open = matchMedia('(min-width: 640px)').matches;
	// The key is a row of chips; tapping one says what it means, tapping it again puts the words away.
	const definition = document.getElementById('key-definition')!;
	const chips = [...document.querySelectorAll<HTMLButtonElement>('.key-chip')];
	for (const chip of chips) {
		chip.addEventListener('click', () => {
			const open = chip.getAttribute('aria-pressed') !== 'true';
			for (const other of chips) other.setAttribute('aria-pressed', String(open && other === chip));
			definition.textContent = open ? `${chip.textContent!.trim()}. ${chip.dataset.text}` : '';
			definition.hidden = !open;
		});
	}
	// The filter: each box switches a group of zone kinds on or off.
	const layersPanel = document.getElementById('layers') as HTMLDetailsElement;
	layersPanel.addEventListener('change', () => {
		const on = [...layersPanel.querySelectorAll<HTMLInputElement>('input[name="zone-group"]:checked')].map((box) => box.value);
		for (const [id, filter] of Object.entries(zoneLayerFilters(enabledKinds(on)))) map.setFilter(id, filter);
		zoneClick?.remove();
		hidePreview();
	});

	// Night moves around the globe, so refresh the shading every minute.
	setInterval(() => (map.getSource('night') as GeoJSONSource).setData(nightGeoJSON(new Date())), 60_000);

	const covered = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		coveredCountryCode(map.queryRenderedFeatures(box, { layers: ['covered-countries'] })[0], guides);

	// Hovering shows a small read-only preview.
	const preview = new Popup({ closeButton: false, closeOnClick: false, offset: 14, maxWidth: '20rem', className: 'country-popup preview' });
	let previewing: string | undefined;
	const canHover = matchMedia('(hover: hover)').matches;
	const hidePreview = () => {
		preview.remove();
		previewing = undefined;
	};

	// The zones under a point, nearest layer first. A zone wins over the country under it.
	const zonesAt = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		map.queryRenderedFeatures(box, { layers: ZONE_LAYER_IDS }).map((f) => f.properties as unknown as ZoneProps);

	// The country under the pointer lifts (feature state; see map-style.ts).
	let lifted: string | undefined;
	const lift = (iso3?: string) => {
		if (iso3 === lifted) return;
		if (lifted) map.setFeatureState({ source: 'countries', id: lifted }, { hover: false });
		if (iso3) map.setFeatureState({ source: 'countries', id: iso3 }, { hover: true });
		lifted = iso3;
	};

	map.on('mousemove', (e) => {
		const zones = zonesAt(tapBox(e.point, 4));
		const iso3 = zones.length ? undefined : covered(e.point);
		lift(iso3);
		map.getCanvas().style.cursor = zones.length || iso3 ? 'pointer' : '';
		if (!canHover || (!zones.length && !iso3)) return hidePreview();
		preview.setLngLat(e.lngLat);
		const key = zones.length ? zones.map((z) => z.id).join() : iso3;
		if (key !== previewing) {
			previewing = key;
			preview.setHTML(zones.length ? zonesPopupHtml(zones, { link: false }) : popupHtml(guides[iso3!])).addTo(map);
		}
	});
	map.getCanvas().addEventListener('mouseleave', () => {
		lift();
		hidePreview();
	});

	// Clicking or tapping opens the full guide in a large popup, so nobody has to leave the map.
	const dialog = document.getElementById('country-dialog') as HTMLDialogElement;
	const panel = dialog.querySelector('.dialog-panel')!;
	const body = dialog.querySelector('.dialog-body')!;
	dialog.querySelector('.dialog-close')!.addEventListener('click', () => dialog.close());
	// The dialog element itself is only hit by clicks on the dimmed area around the panel.
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
	// "My drone weighs X g": answered from the open country's registration weight.
	body.addEventListener('input', (e) => {
		const field = e.target as HTMLInputElement;
		if (!field.matches('.weight input')) return;
		const threshold = field.dataset.threshold ? Number(field.dataset.threshold) : null;
		field.closest('.weight')!.querySelector('.weight-answer')!.textContent = field.value ? weightAnswer(Number(field.value), threshold) : '';
	});
	// On a phone the sheet can be dragged down by its handle to close it.
	const handle = dialog.querySelector<HTMLElement>('.sheet-handle')!;
	let dragFrom: number | undefined;
	handle.addEventListener('pointerdown', (e) => {
		dragFrom = e.clientY;
		handle.setPointerCapture(e.pointerId);
	});
	handle.addEventListener('pointermove', (e) => {
		if (dragFrom !== undefined) panel.setAttribute('style', `transform: translateY(${Math.max(0, e.clientY - dragFrom)}px); transition: none`);
	});
	const endDrag = (e: PointerEvent) => {
		if (dragFrom === undefined) return;
		const far = e.clientY - dragFrom > 100;
		dragFrom = undefined;
		panel.removeAttribute('style');
		if (far) dialog.close();
	};
	handle.addEventListener('pointerup', endDrag);
	handle.addEventListener('pointercancel', endDrag);
	dialog.addEventListener('close', () => history.replaceState(null, '', location.pathname + searchWithCountry(location.search) + location.hash));

	// Query a small box around the tap so a fingertip doesn't have to be pixel-perfect. A zone opens a small popup
	// with a link to its source; a guided country with no zone under the tap opens the full guide.
	let zoneClick: Popup | undefined;
	map.on('click', (e) => {
		zoneClick?.remove();
		const zones = zonesAt(tapBox(e.point));
		if (zones.length) {
			hidePreview();
			zoneClick = new Popup({ offset: 14, maxWidth: '20rem', className: 'country-popup' })
				.setLngLat(e.lngLat)
				.setHTML(zonesPopupHtml(zones, { link: true }) + weatherBlockHtml(e.lngLat.lat, e.lngLat.lng))
				.addTo(map);
			return;
		}
		// The exact point first: with neighbours that all have guides, the padded box can hold the wrong country.
		const iso3 = covered(e.point) ?? covered(tapBox(e.point));
		if (iso3) openSummary(iso3, e.lngLat);
	});

	// A zone popup's "See this country's rules" button opens that country's summary.
	document.addEventListener('click', (e) => {
		const iso3 = (e.target as Element).closest<HTMLElement>('.country-popup [data-iso3]')?.dataset.iso3;
		if (!iso3 || !Object.hasOwn(guides, iso3)) return;
		const point = zoneClick?.getLngLat();
		zoneClick?.remove();
		openSummary(iso3, point);
	});

	// "Show weather here" in a popup or the summary: the only thing that sends a spot anywhere (to our own Worker, which asks Open-Meteo).
	document.addEventListener('click', async (e) => {
		const button = (e.target as Element).closest<HTMLButtonElement>('button[data-weather]');
		if (!button) return;
		const result = button.closest('.weather')!.querySelector('.weather-result')!;
		button.disabled = true;
		result.textContent = 'Loading the weather…';
		try {
			const lat = Number(button.dataset.lat);
			const lon = Number(button.dataset.lon);
			const response = await fetch(weatherPath(lat, lon));
			if (!response.ok) throw new Error(String(response.status));
			result.innerHTML = weatherHtml((await response.json()) as Weather, lat, lon);
		} catch {
			result.textContent = weatherErrorMessage();
		}
		button.disabled = false;
	});

	// The countries opened last, kept in this browser only, shown as chips under the search.
	const POPULAR = ['GBR', 'USA', 'JPN', 'AUS'];
	let recent: string[] = [];
	try {
		recent = JSON.parse(localStorage.getItem('recent-countries') ?? '[]');
		if (!Array.isArray(recent)) recent = [];
	} catch {}
	// Saved countries: iso3 -> the date the guide was last checked when the visitor saved or last opened it.
	let saved: Saved = {};
	try {
		saved = parseSaved(localStorage.getItem('saved-countries'));
	} catch {}
	const keepSaved = () => {
		try {
			localStorage.setItem('saved-countries', JSON.stringify(saved));
		} catch {}
	};
	const chipList = document.getElementById('chips')!;
	function renderChips() {
		const changed = changedSince(saved, guides);
		chipList.replaceChildren(
			...chipCountries(Object.keys(saved), recent, POPULAR, guides).map((iso3) => {
				const li = document.createElement('li');
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = Object.hasOwn(saved, iso3) ? `★ ${guides[iso3].name}${changed.includes(iso3) ? ' (updated)' : ''}` : guides[iso3].name;
				button.addEventListener('click', () => goTo(iso3));
				li.append(button);
				return li;
			}),
		);
	}
	renderChips();

	let current = '';
	// `point` is where the visitor clicked, if they did: it lets the summary offer the weather there.
	function openSummary(iso3: string, point?: { lat: number; lng: number }) {
		hidePreview();
		recent = pushRecent(recent, iso3);
		try {
			localStorage.setItem('recent-countries', JSON.stringify(recent));
		} catch {}
		saved = markSeen(saved, iso3, guides[iso3].lastVerified);
		keepSaved();
		renderChips();
		current = iso3;
		history.replaceState(null, '', location.pathname + searchWithCountry(location.search, iso3) + location.hash);
		// A short pulse on the country that was picked.
		map.setFeatureState({ source: 'countries', id: iso3 }, { picked: true });
		setTimeout(() => map.setFeatureState({ source: 'countries', id: iso3 }, { picked: false }), 700);
		body.innerHTML = summaryHtml(guides[iso3]) + (point ? weatherBlockHtml(point.lat, point.lng) : '');
		const saveButton = body.querySelector<HTMLButtonElement>('.save')!;
		const showSaved = () => {
			const on = Object.hasOwn(saved, iso3);
			saveButton.setAttribute('aria-pressed', String(on));
			saveButton.textContent = on ? 'Saved. Tap to remove' : 'Save this country';
		};
		showSaved();
		saveButton.addEventListener('click', () => {
			saved = toggleSaved(saved, iso3, guides[iso3].lastVerified);
			keepSaved();
			showSaved();
			renderChips();
		});
		dialog.setAttribute('aria-label', `Drone rules in ${guides[iso3].name}`);
		dialog.showModal();
		body.scrollTop = 0;
		panel.scrollTop = 0;
	}

	// Search: type a country, pick it, and the globe spins there and opens its summary.
	const searchInput = document.getElementById('country-search') as HTMLInputElement;
	const results = document.getElementById('search-results') as HTMLUListElement;
	const closeResults = () => {
		results.hidden = true;
		searchInput.setAttribute('aria-expanded', 'false');
	};
	function goTo(iso3: string) {
		stopSpin();
		closeResults();
		searchInput.value = guides[iso3].name;
		searchInput.blur();
		intro.classList.add('hidden');
		zoneClick?.remove();
		hidePreview();
		const camera = map.cameraForBounds(bounds[iso3], { padding: 60, maxZoom: 5 });
		if (!camera) return openSummary(iso3);
		flyThen(camera, () => openSummary(iso3));
	}
	// flyTo zooms out, turns the globe and zooms back in; with reduced motion, jump straight there.
	function flyThen(camera: { center?: unknown; zoom?: number }, done: () => void) {
		map.once('moveend', done);
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) map.jumpTo(camera as never);
		else map.flyTo({ ...camera, duration: 3500, essential: true, easing: (t: number) => 1 - (1 - t) ** 3 } as never);
	}

	// "Use my location": the position is used in this page only, to find the country, and is never sent anywhere.
	const locateButton = document.getElementById('locate') as HTMLButtonElement;
	const locateStatus = document.getElementById('locate-status')!;
	// "Near me" is spelled out until the button has been used once; after that the icon is enough.
	try {
		if (localStorage.getItem('located')) locateButton.classList.add('used');
	} catch {}
	let here: Marker | undefined;
	const say = (text: string) => {
		locateStatus.textContent = text;
		locateStatus.hidden = false;
	};
	locateButton.addEventListener('click', () => {
		try {
			localStorage.setItem('located', '1');
		} catch {}
		if (!('geolocation' in navigator)) return say(locateErrorMessage(2));
		stopSpin();
		closeResults();
		say('Finding your location…');
		locateButton.disabled = true;
		navigator.geolocation.getCurrentPosition(
			async ({ coords }) => {
				try {
					const { latitude: lat, longitude: lon } = coords;
					const response = await fetch(COUNTRIES_URL);
					if (!response.ok) throw new Error(String(response.status));
					const country = countryAt(lon, lat, (await response.json()).features);
					const guide = country && Object.hasOwn(guides, country.iso3) ? country.iso3 : undefined;
					intro.classList.add('hidden');
					zoneClick?.remove();
					hidePreview();
					here?.remove();
					here = new Marker({ element: Object.assign(document.createElement('div'), { className: 'you-are-here' }) }).setLngLat([lon, lat]).addTo(map);
					say(locatedMessage(country, guide !== undefined));
					flyThen({ center: [lon, lat], zoom: 6 }, () => guide && openSummary(guide));
				} catch {
					say(locateErrorMessage(2));
				} finally {
					locateButton.disabled = false;
				}
			},
			(error) => {
				say(locateErrorMessage(error.code));
				locateButton.disabled = false;
			},
			{ timeout: 10_000, maximumAge: 60_000 },
		);
	});
	const showResults = () => {
		const hits = searchCountries(searchInput.value, guides);
		results.replaceChildren(
			...hits.map((h, i) => {
				const li = document.createElement('li');
				li.role = 'option';
				li.id = `search-result-${i}`;
				li.dataset.iso3 = h.iso3;
				li.textContent = h.name;
