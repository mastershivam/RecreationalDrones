---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { guideSummaries } from '../lib/guides';

// iso3 -> key facts for the popup, read by the map script below.
const guides = guideSummaries(await getCollection('countries'));
---

<Base title="Recreational drone rules map" fill>
	<div class="stage">
		<div id="map" data-guides={JSON.stringify(guides)}></div>
		<div class="intro card">
			<h1>Where can you fly?</h1>
			<p class="muted">Drag to spin the globe. Hover or tap a glowing country for its key drone rules.</p>
			<p class="muted legend"><span class="swatch"></span>Shaded areas are in night right now.</p>
		</div>
	</div>
</Base>

<script>
	import { Map, Popup, setWorkerUrl, type GeoJSONSource } from 'maplibre-gl';
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import { guideForFeature, initialZoom, readMapColors, tapBox } from '../lib/map-config';
	import type { GuideSummary } from '../lib/guides';
	import { buildStyle } from '../lib/map-style';
	import { popupHtml } from '../lib/popup';
	import { nightGeoJSON } from '../lib/daynight';

	// MapLibre looks for its worker next to its own module, which breaks once bundled.
	setWorkerUrl(workerUrl);

	const el = document.getElementById('map')!;
	const guides: Record<string, GuideSummary> = JSON.parse(el.dataset.guides!);
	const colors = readMapColors((name) => getComputedStyle(document.documentElement).getPropertyValue(name));

	const map = new Map({
		container: el,
		style: buildStyle(colors, guides, location.origin),
		center: [-4, 42],
		zoom: initialZoom(el.clientWidth, el.clientHeight),
		// The basemap tiles stop at zoom 5 (BASEMAP_MAX_ZOOM); beyond that the map just enlarges them.
		maxZoom: 6,
		// Keep the globe upright; tilting it is easy to do by accident with two fingers.
		pitchWithRotate: false,
		touchPitch: false,
	});

	const intro = document.querySelector('.intro')!;
	map.once('dragstart', () => intro.classList.add('hidden'));

	// Night moves around the globe, so refresh the shading every minute.
	setInterval(() => (map.getSource('night') as GeoJSONSource).setData(nightGeoJSON(new Date())), 60_000);

	const query = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		guideForFeature(map.queryRenderedFeatures(box, { layers: ['covered-countries'] })[0], guides);

	// Hovering shows a read-only preview; clicking or tapping pins a popup that has links in it.
	const preview = new Popup({ closeButton: false, closeOnClick: false, offset: 14, maxWidth: '20rem', className: 'country-popup preview' });
	let pinned: Popup | null = null;
	let previewing: GuideSummary | undefined;
	const canHover = matchMedia('(hover: hover)').matches;

	map.on('mousemove', (e) => {
		const guide = query(e.point);
		map.getCanvas().style.cursor = guide ? 'pointer' : '';
		if (!canHover || pinned || !guide) {
			preview.remove();
			previewing = undefined;
			return;
		}
		preview.setLngLat(e.lngLat);
		if (guide !== previewing) {
			previewing = guide;
			preview.setHTML(popupHtml(guide, false)).addTo(map);
		}
	});
	map.getCanvas().addEventListener('mouseleave', () => {
		preview.remove();
		previewing = undefined;
	});

	// Query a small box around the tap so a fingertip doesn't have to be pixel-perfect.
	map.on('click', (e) => {
		pinned?.remove();
		pinned = null;
		const guide = query(tapBox(e.point));
		preview.remove();
		previewing = undefined;
		if (!guide) return;
		pinned = new Popup({ offset: 14, maxWidth: '20rem', className: 'country-popup' })
			.setLngLat(e.lngLat)
			.setHTML(popupHtml(guide, true))
			.addTo(map);
		pinned.on('close', () => (pinned = null));
	});
</script>

<style>
	.stage {
		position: relative;
		flex: 1;
		min-height: 420px;
		/* Let the map handle all touch gestures instead of scrolling the page. */
		touch-action: none;
	}
	#map {
		position: absolute;
		inset: 0;
		background: var(--color-ocean);
	}
	.intro {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		right: var(--space-2);
		max-width: 20rem;
		padding: var(--space-2) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 85%, transparent);
		backdrop-filter: blur(6px);
		transition: opacity 0.4s;
	}
	.intro.hidden {
		opacity: 0;
		pointer-events: none;
	}
	.intro h1 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-lg);
	}
	.intro p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.legend {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}
	.swatch {
		flex: none;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--color-night);
		border: 1px solid var(--color-land-border);
	}
	@media (min-width: 640px) {
		.intro {
			top: var(--space-3);
			left: var(--space-3);
			padding: var(--space-3) var(--space-4);
		}
	}
	/* The popup is created by MapLibre, so these styles must be global. */
	:global(.country-popup .maplibregl-popup-content) {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.45;
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
	}
	:global(.country-popup .maplibregl-popup-tip) {
		display: none;
	}
	:global(.country-popup .maplibregl-popup-content) {
		max-height: 60vh;
		max-height: 60dvh;
		overflow-y: auto;
	}
	/* On phones there isn't room beside the tapped point, so dock the popup to the bottom of the map.
	   !important is needed to override the position MapLibre sets directly on the element. */
	@media (max-width: 640px) {
		:global(.country-popup.maplibregl-popup) {
			top: auto !important;
			left: var(--space-2) !important;
			right: var(--space-2);
			/* Sits above the attribution link, which must stay visible. */
			bottom: 3rem;
			transform: none !important;
			max-width: none !important;
		}
	}
	:global(.country-popup.preview) {
		pointer-events: none;
	}
	:global(.country-popup .maplibregl-popup-close-button) {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		/* A finger-sized target for closing the popup. */
		width: 2.75rem;
		height: 2.75rem;
	}
	:global(.country-popup .popup-title) {
		margin: 0 var(--space-4) var(--space-2) 0;
		font-size: var(--text-base);
	}
	:global(.country-popup dl) {
		margin: 0;
	}
	:global(.country-popup dt) {
		color: var(--color-text-muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-top: var(--space-2);
	}
	:global(.country-popup dd) {
		margin: 0;
	}
	:global(.country-popup .popup-meta) {
		margin: var(--space-3) 0 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
	}
	:global(.country-popup .popup-link) {
		display: inline-block;
		margin-top: var(--space-2);
		padding: var(--space-2) 0;
		font-weight: 600;
	}
</style>
