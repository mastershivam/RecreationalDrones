---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CountryGuide from '../components/CountryGuide.astro';
import { guideSummaries } from '../lib/guides';

const countries = await getCollection('countries');
// iso3 -> key facts for the hover preview, read by the map script below.
const guides = guideSummaries(countries);
---

<Base title="Recreational drone rules map" fill>
	<div class="stage">
		<div id="map" data-guides={JSON.stringify(guides)}></div>
		<div class="intro card">
			<h1>Where can you fly?</h1>
			<p class="muted">Drag to spin the globe. Hover over a glowing country for a preview, or click or tap it for the full guide.</p>
			<p class="muted legend"><span class="swatch"></span>Shaded areas are in night right now.</p>
		</div>
	</div>

	<!-- The large popup: opened by clicking a country, filled from the matching template below. -->
	<dialog id="country-dialog" aria-label="Country guide">
		<div class="dialog-panel">
			<button type="button" class="dialog-close" aria-label="Close">×</button>
			<div class="dialog-body"></div>
		</div>
	</dialog>

	<!-- Each country's full guide, rendered at build time, so opening it needs no request. -->
	{
		countries.map((country) => (
			<template id={`guide-${country.data.iso3}`}>
				<CountryGuide country={country} />
			</template>
		))
	}
</Base>

<script>
	import { Map, Popup, addProtocol, setWorkerUrl, type GeoJSONSource } from 'maplibre-gl';
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import { Protocol } from 'pmtiles';
	import { coveredCountryCode, initialZoom, readMapColors, tapBox } from '../lib/map-config';
	import type { GuideSummary } from '../lib/guides';
	import { buildStyle } from '../lib/map-style';
	import { popupHtml } from '../lib/popup';
	import { nightGeoJSON } from '../lib/daynight';

	// MapLibre looks for its worker next to its own module, which breaks once bundled.
	setWorkerUrl(workerUrl);
	// Lets MapLibre read tiles straight out of the single .pmtiles file with HTTP byte ranges.
	addProtocol('pmtiles', new Protocol().tile);

	const el = document.getElementById('map')!;
	const guides: Record<string, GuideSummary> = JSON.parse(el.dataset.guides!);
	const colors = readMapColors((name) => getComputedStyle(document.documentElement).getPropertyValue(name));

	const map = new Map({
		container: el,
		style: buildStyle(colors, guides, location.origin),
		center: [-4, 42],
		zoom: initialZoom(el.clientWidth, el.clientHeight),
		// The basemap tiles stop at zoom 7 in production (5 in the small test file); the map enlarges them beyond that.
		maxZoom: 8,
		// Keep the globe upright; tilting it is easy to do by accident with two fingers.
		pitchWithRotate: false,
		touchPitch: false,
	});

	// Hooks for the end-to-end tests: `data-ready` says every tile has loaded, and ?e2e exposes the map
	// so tests can find where a country is on screen.
	map.once('idle', () => (el.dataset.ready = 'true'));
	if (location.search.includes('e2e')) (window as unknown as { __map: Map }).__map = map;

	const intro = document.querySelector('.intro')!;
	map.once('dragstart', () => intro.classList.add('hidden'));

	// Night moves around the globe, so refresh the shading every minute.
	setInterval(() => (map.getSource('night') as GeoJSONSource).setData(nightGeoJSON(new Date())), 60_000);

	const covered = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		coveredCountryCode(map.queryRenderedFeatures(box, { layers: ['covered-countries'] })[0], guides);

	// Hovering shows a small read-only preview.
	const preview = new Popup({ closeButton: false, closeOnClick: false, offset: 14, maxWidth: '20rem', className: 'country-popup preview' });
	let previewing: string | undefined;
	const canHover = matchMedia('(hover: hover)').matches;
	const hidePreview = () => {
		preview.remove();
		previewing = undefined;
	};

	map.on('mousemove', (e) => {
		const iso3 = covered(e.point);
		map.getCanvas().style.cursor = iso3 ? 'pointer' : '';
		if (!canHover || !iso3) return hidePreview();
		preview.setLngLat(e.lngLat);
		if (iso3 !== previewing) {
			previewing = iso3;
			preview.setHTML(popupHtml(guides[iso3])).addTo(map);
		}
	});
	map.getCanvas().addEventListener('mouseleave', hidePreview);

	// Clicking or tapping opens the full guide in a large popup, so nobody has to leave the map.
	const dialog = document.getElementById('country-dialog') as HTMLDialogElement;
	const panel = dialog.querySelector('.dialog-panel')!;
	const body = dialog.querySelector('.dialog-body')!;
	dialog.querySelector('.dialog-close')!.addEventListener('click', () => dialog.close());
	// The dialog element itself is only hit by clicks on the dimmed area around the panel.
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

	// Query a small box around the tap so a fingertip doesn't have to be pixel-perfect.
	map.on('click', (e) => {
		const iso3 = covered(tapBox(e.point));
		const guide = iso3 && (document.getElementById(`guide-${iso3}`) as HTMLTemplateElement | null);
		if (!iso3 || !guide) return;
		hidePreview();
		body.replaceChildren(guide.content.cloneNode(true));
		dialog.setAttribute('aria-label', `Drone rules in ${guides[iso3].name}`);
		dialog.showModal();
		body.scrollTop = 0;
		panel.scrollTop = 0;
	});
</script>

<style>
	.stage {
		position: relative;
		flex: 1;
		min-height: 420px;
		/* Let the map handle all touch gestures instead of scrolling the page. */
		touch-action: none;
	}
	#map {
		position: absolute;
		inset: 0;
		background: var(--color-ocean);
	}
	.intro {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		right: var(--space-2);
		max-width: 20rem;
		padding: var(--space-2) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 85%, transparent);
		backdrop-filter: blur(6px);
		transition: opacity 0.4s;
	}
	.intro.hidden {
		opacity: 0;
		pointer-events: none;
	}
	.intro h1 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-lg);
	}
	.intro p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.legend {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}
	.swatch {
		flex: none;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--color-night);
		border: 1px solid var(--color-land-border);
	}
	@media (min-width: 640px) {
		.intro {
			top: var(--space-3);
			left: var(--space-3);
			padding: var(--space-3) var(--space-4);
		}
	}
	/* The hover preview is created by MapLibre, so these styles must be global. */
	:global(.country-popup .maplibregl-popup-content) {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		line-height: 1.45;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--color-night) 50%, transparent);
	}
	:global(.country-popup .maplibregl-popup-tip) {
		display: none;
	}
	:global(.country-popup.preview) {
		pointer-events: none;
	}
	:global(.country-popup .popup-title) {
		margin: 0 0 var(--space-2);
		font-size: var(--text-base);
	}
	:global(.country-popup dl) {
		margin: 0;
	}
	:global(.country-popup dt) {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-top: var(--space-2);
	}
	:global(.country-popup dd) {
		margin: 0;
	}
	:global(.country-popup .popup-meta) {
		margin: var(--space-3) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-xs);
	}

	/* The large popup. The dialog itself is transparent and unpadded, so a click on it is a click on the backdrop. */
	dialog {
		width: min(46rem, calc(100% - var(--space-3)));
		max-width: none;
		max-height: none;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		overflow: visible;
	}
	dialog::backdrop {
		background: color-mix(in srgb, var(--color-night) 75%, transparent);
	}
	.dialog-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		max-height: calc(100vh - var(--space-4));
		max-height: calc(100dvh - var(--space-4));
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}
	.dialog-body {
		overflow-y: auto;
		padding: var(--space-4);
		overscroll-behavior: contain;
		overflow-wrap: anywhere;
	}
	.dialog-body :global(h1) {
		margin: 0 var(--space-5) var(--space-1) 0;
		font-size: var(--text-lg);
	}
	.dialog-close {
		position: absolute;
		top: var(--space-1);
		right: var(--space-1);
		/* A finger-sized target. */
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		line-height: 1;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.dialog-close:hover {
		background: var(--color-surface-raised);
		color: var(--color-text);
	}
	.dialog-close:active {
		background: var(--color-border);
	}
</style>
