---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { guideSummaries } from '../lib/guides';
import { mainlandBounds } from '../lib/country-bounds';
import { LEVELS } from '../lib/restrictiveness';
import { ZONE_GROUPS } from '../lib/zones';

const countries = await getCollection('countries');
// iso3 -> key facts for the hover preview, read by the map script below.
const guides = guideSummaries(countries);
// Where each guided country is, so searching for it can fly the globe there.
const bounds = mainlandBounds(JSON.parse(readFileSync('public/data/countries.geojson', 'utf8')).features, Object.keys(guides));
---

<Base title="Recreational Drones: drone rules by country, on a map" description="Search a country or spin the globe to see how strict its drone rules are, how to register, and where to check before you fly." fill>
	<div class="stage">
		<div id="map" data-guides={JSON.stringify(guides)} data-bounds={JSON.stringify(bounds)}></div>
		<div class="top">
			<form class="search" role="search" autocomplete="off">
				<label class="visually-hidden" for="country-search">Search for a country</label>
				<input id="country-search" type="search" placeholder="Search for a country" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
				<button type="button" id="locate" aria-label="Use my location" title="Use my location. It stays in your browser and is never sent anywhere.">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="1.5" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" /></svg>
				</button>
				<ul id="search-results" role="listbox" aria-label="Matching countries" hidden></ul>
			</form>
			<p class="locate-status card" id="locate-status" role="status" hidden></p>
			<div class="intro card">
				<h1>Where can you fly?</h1>
				<p class="muted">Search for a country, or drag to spin the globe. Click or tap a glowing country for a summary.</p>
				<p class="muted legend"><span class="swatch"></span>Shaded areas are in night right now.</p>
			</div>
		</div>
		<details class="layers card" id="layers">
			<summary>Key</summary>
			<h2>How strict are the rules?</h2>
			<ul class="levels">
				{
					LEVELS.map((l) => (
						<li>
							<span class="chip" style={`background: var(--color-level-${l.level})`} aria-hidden="true" />
							<span><strong>{l.label}.</strong> {l.criteria}</span>
						</li>
					))
				}
			</ul>
			<h2>Zones</h2>
			<p class="muted">Zoom in close to see them. A zone says what a place is and who says so; check the source before you fly.</p>
			<fieldset>
				<legend class="visually-hidden">Show on the map</legend>
				{
					ZONE_GROUPS.map((g) => (
						<label>
							<input type="checkbox" name="zone-group" value={g.id} checked />
							<svg class={`key ${g.id}`} viewBox="0 0 20 20" aria-hidden="true">
								{g.id === 'airport' && <circle cx="10" cy="10" r="8" />}
								{g.id === 'approval' && <rect x="2" y="3" width="16" height="14" />}
								{g.id === 'site' && <circle cx="10" cy="10" r="5" />}
							</svg>
							{g.label}
						</label>
					))
				}
			</fieldset>
			<p class="muted" id="zones-status" role="status"></p>
		</details>
	</div>

	<!-- The large popup: opened by clicking a country or searching for one, and filled with its summary. -->
	<dialog id="country-dialog" aria-label="Country guide">
		<div class="dialog-panel">
			<button type="button" class="dialog-close" aria-label="Close">×</button>
			<div class="dialog-body"></div>
		</div>
	</dialog>

</Base>

<script>
	import { Map, Marker, Popup, addProtocol, setWorkerUrl, type GeoJSONSource } from 'maplibre-gl';
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import { Protocol } from 'pmtiles';
	import { coveredCountryCode, initialZoom, readMapColors, tapBox } from '../lib/map-config';
	import type { GuideSummary } from '../lib/guides';
	import { buildStyle } from '../lib/map-style';
	import { popupHtml, summaryHtml } from '../lib/popup';
	import { searchCountries } from '../lib/search';
	import { mountFlow } from '../lib/flow-canvas';
	import { flowOpacity } from '../lib/flow-field';
	import { countryAt, locateErrorMessage, locatedMessage } from '../lib/geo';
	import type { Bounds } from '../lib/country-bounds';
	import { nightGeoJSON } from '../lib/daynight';
	import { ZONE_LAYER_IDS, enabledKinds, zoneLayerFilters, zonesPopupHtml, zoneFeatures, type ZoneProps } from '../lib/zones';
	import { COUNTRIES_URL, ZONES_URL } from '../lib/map-style';

	// MapLibre looks for its worker next to its own module, which breaks once bundled.
	setWorkerUrl(workerUrl);
	// Lets MapLibre read tiles straight out of the single .pmtiles file with HTTP byte ranges.
	addProtocol('pmtiles', new Protocol().tile);

	const el = document.getElementById('map')!;
	const guides: Record<string, GuideSummary> = JSON.parse(el.dataset.guides!);
	const bounds: Record<string, Bounds> = JSON.parse(el.dataset.bounds!);
	const colors = readMapColors((name) => getComputedStyle(document.documentElement).getPropertyValue(name));

	const map = new Map({
		container: el,
		style: buildStyle(colors, guides, location.origin),
		center: [-4, 42],
		zoom: initialZoom(el.clientWidth, el.clientHeight),
		// The basemap tiles stop at zoom 7 in production (5 in the small test file); the map enlarges them beyond that.
		maxZoom: 8,
		// Keep the globe upright; tilting it is easy to do by accident with two fingers.
		pitchWithRotate: false,
		touchPitch: false,
	});

	// Hooks for the end-to-end tests: `data-ready` says every tile has loaded, and ?e2e exposes the map
	// so tests can find where a country is on screen.
	map.once('idle', () => (el.dataset.ready = 'true'));
	if (location.search.includes('e2e')) (window as unknown as { __map: Map }).__map = map;

	// The flow-field backdrop: lines drifting over the globe, above the map's canvas and below its popups and markers.
	// It thins out as you zoom in, and is gone by the zoom at which zones appear.
	const flow = Object.assign(document.createElement('canvas'), { className: 'flow' });
	flow.setAttribute('aria-hidden', 'true');
	map.getCanvas().after(flow);
	mountFlow(flow);
	const fadeFlow = () => (flow.style.opacity = String(flowOpacity(map.getZoom())));
	fadeFlow();
	map.on('zoom', fadeFlow);

	const intro = document.querySelector('.intro')!;
	map.once('dragstart', () => intro.classList.add('hidden'));

	// Zones load after the globe is up, since the globe does not need them. If they fail, say so plainly.
	const zonesStatus = document.getElementById('zones-status')!;
	map.once('load', async () => {
		try {
			const response = await fetch(ZONES_URL);
			if (!response.ok) throw new Error(String(response.status));
			(map.getSource('zones') as GeoJSONSource).setData(zoneFeatures(await response.json()) as never);
			map.once('idle', () => (el.dataset.zones = 'ready'));
		} catch {
			zonesStatus.textContent = 'Zones could not be loaded. The map still works.';
			el.dataset.zones = 'failed';
		}
	});

	// The filter: each box switches a group of zone kinds on or off. A closed panel is a small tab on a phone.
	const layersPanel = document.getElementById('layers') as HTMLDetailsElement;
	layersPanel.open = matchMedia('(min-width: 640px)').matches;
	layersPanel.addEventListener('change', () => {
		const on = [...layersPanel.querySelectorAll<HTMLInputElement>('input[name="zone-group"]:checked')].map((box) => box.value);
		for (const [id, filter] of Object.entries(zoneLayerFilters(enabledKinds(on)))) map.setFilter(id, filter);
		zoneClick?.remove();
		hidePreview();
	});

	// Night moves around the globe, so refresh the shading every minute.
	setInterval(() => (map.getSource('night') as GeoJSONSource).setData(nightGeoJSON(new Date())), 60_000);

	const covered = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		coveredCountryCode(map.queryRenderedFeatures(box, { layers: ['covered-countries'] })[0], guides);

	// Hovering shows a small read-only preview.
	const preview = new Popup({ closeButton: false, closeOnClick: false, offset: 14, maxWidth: '20rem', className: 'country-popup preview' });
	let previewing: string | undefined;
	const canHover = matchMedia('(hover: hover)').matches;
	const hidePreview = () => {
		preview.remove();
		previewing = undefined;
	};

	// The zones under a point, nearest layer first. A zone wins over the country under it.
	const zonesAt = (box: Parameters<typeof map.queryRenderedFeatures>[0]) =>
		map.queryRenderedFeatures(box, { layers: ZONE_LAYER_IDS }).map((f) => f.properties as unknown as ZoneProps);

	map.on('mousemove', (e) => {
		const zones = zonesAt(tapBox(e.point, 4));
		const iso3 = zones.length ? undefined : covered(e.point);
		map.getCanvas().style.cursor = zones.length || iso3 ? 'pointer' : '';
		if (!canHover || (!zones.length && !iso3)) return hidePreview();
		preview.setLngLat(e.lngLat);
		const key = zones.length ? zones.map((z) => z.id).join() : iso3;
		if (key !== previewing) {
			previewing = key;
			preview.setHTML(zones.length ? zonesPopupHtml(zones, { link: false }) : popupHtml(guides[iso3!])).addTo(map);
		}
	});
	map.getCanvas().addEventListener('mouseleave', hidePreview);

	// Clicking or tapping opens the full guide in a large popup, so nobody has to leave the map.
	const dialog = document.getElementById('country-dialog') as HTMLDialogElement;
	const panel = dialog.querySelector('.dialog-panel')!;
	const body = dialog.querySelector('.dialog-body')!;
	dialog.querySelector('.dialog-close')!.addEventListener('click', () => dialog.close());
	// The dialog element itself is only hit by clicks on the dimmed area around the panel.
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

	// Query a small box around the tap so a fingertip doesn't have to be pixel-perfect. A zone opens a small popup
	// with a link to its source; a guided country with no zone under the tap opens the full guide.
	let zoneClick: Popup | undefined;
	map.on('click', (e) => {
		zoneClick?.remove();
		const zones = zonesAt(tapBox(e.point));
		if (zones.length) {
			hidePreview();
			zoneClick = new Popup({ offset: 14, maxWidth: '20rem', className: 'country-popup' })
				.setLngLat(e.lngLat)
				.setHTML(zonesPopupHtml(zones, { link: true }))
				.addTo(map);
			return;
		}
		// The exact point first: with neighbours that all have guides, the padded box can hold the wrong country.
		const iso3 = covered(e.point) ?? covered(tapBox(e.point));
		if (iso3) openSummary(iso3);
	});

	// A zone popup's "See this country's rules" button opens that country's summary.
	document.addEventListener('click', (e) => {
		const iso3 = (e.target as Element).closest<HTMLElement>('.country-popup [data-iso3]')?.dataset.iso3;
		if (!iso3 || !Object.hasOwn(guides, iso3)) return;
		zoneClick?.remove();
		openSummary(iso3);
	});

	function openSummary(iso3: string) {
		hidePreview();
		body.innerHTML = summaryHtml(guides[iso3]);
		dialog.setAttribute('aria-label', `Drone rules in ${guides[iso3].name}`);
		dialog.showModal();
		body.scrollTop = 0;
		panel.scrollTop = 0;
	}

	// Search: type a country, pick it, and the globe spins there and opens its summary.
	const searchInput = document.getElementById('country-search') as HTMLInputElement;
	const results = document.getElementById('search-results') as HTMLUListElement;
	const closeResults = () => {
		results.hidden = true;
		searchInput.setAttribute('aria-expanded', 'false');
	};
	function goTo(iso3: string) {
		closeResults();
		searchInput.value = guides[iso3].name;
		searchInput.blur();
		intro.classList.add('hidden');
		zoneClick?.remove();
		hidePreview();
		const camera = map.cameraForBounds(bounds[iso3], { padding: 60, maxZoom: 5 });
		if (!camera) return openSummary(iso3);
		flyThen(camera, () => openSummary(iso3));
	}
	// flyTo zooms out, turns the globe and zooms back in; with reduced motion, jump straight there.
	function flyThen(camera: { center?: unknown; zoom?: number }, done: () => void) {
		map.once('moveend', done);
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) map.jumpTo(camera as never);
		else map.flyTo({ ...camera, duration: 3500, essential: true } as never);
	}

	// "Use my location": the position is used in this page only, to find the country, and is never sent anywhere.
	const locateButton = document.getElementById('locate') as HTMLButtonElement;
	const locateStatus = document.getElementById('locate-status')!;
	let here: Marker | undefined;
	const say = (text: string) => {
		locateStatus.textContent = text;
		locateStatus.hidden = false;
	};
	locateButton.addEventListener('click', () => {
		if (!('geolocation' in navigator)) return say(locateErrorMessage(2));
		closeResults();
		say('Finding your location…');
		locateButton.disabled = true;
		navigator.geolocation.getCurrentPosition(
			async ({ coords }) => {
				try {
					const { latitude: lat, longitude: lon } = coords;
					const response = await fetch(COUNTRIES_URL);
					if (!response.ok) throw new Error(String(response.status));
					const country = countryAt(lon, lat, (await response.json()).features);
					const guide = country && Object.hasOwn(guides, country.iso3) ? country.iso3 : undefined;
					intro.classList.add('hidden');
					zoneClick?.remove();
					hidePreview();
					here?.remove();
					here = new Marker({ element: Object.assign(document.createElement('div'), { className: 'you-are-here' }) }).setLngLat([lon, lat]).addTo(map);
					say(locatedMessage(country, guide !== undefined));
					flyThen({ center: [lon, lat], zoom: 6 }, () => guide && openSummary(guide));
				} catch {
					say(locateErrorMessage(2));
				} finally {
					locateButton.disabled = false;
				}
			},
			(error) => {
				say(locateErrorMessage(error.code));
				locateButton.disabled = false;
			},
			{ timeout: 10_000, maximumAge: 60_000 },
		);
	});
	const showResults = () => {
		const hits = searchCountries(searchInput.value, guides);
		results.replaceChildren(
			...hits.map((h, i) => {
				const li = document.createElement('li');
				li.role = 'option';
				li.id = `search-result-${i}`;
				li.dataset.iso3 = h.iso3;
				li.textContent = h.name;
				return li;
			}),
		);
		if (searchInput.value.trim() && !hits.length) {
			const li = document.createElement('li');
			li.className = 'none';
			li.textContent = 'No guide for that country yet';
			results.append(li);
		}
		results.hidden = !results.children.length;
		searchInput.setAttribute('aria-expanded', String(!results.hidden));
		searchInput.removeAttribute('aria-activedescendant');
	};
	searchInput.addEventListener('input', showResults);
	searchInput.addEventListener('focus', showResults);
	// pointerdown, not click: the input loses focus first, and that must not hide the list before it is used.
	results.addEventListener('pointerdown', (e) => {
		const iso3 = (e.target as HTMLElement).closest<HTMLElement>('[data-iso3]')?.dataset.iso3;
		if (!iso3) return;
		e.preventDefault();
		goTo(iso3);
	});
	searchInput.addEventListener('blur', closeResults);
	searchInput.addEventListener('keydown', (e) => {
		const options = [...results.querySelectorAll<HTMLElement>('[data-iso3]')];
		const current = options.findIndex((o) => o.id === searchInput.getAttribute('aria-activedescendant'));
		if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
			if (!options.length) return;
			e.preventDefault();
			const next = options[(current + (e.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length];
			options.forEach((o) => o.removeAttribute('aria-selected'));
			next.setAttribute('aria-selected', 'true');
			searchInput.setAttribute('aria-activedescendant', next.id);
		} else if (e.key === 'Escape') closeResults();
	});
	// Enter picks the highlighted match, or the first one.
	searchInput.form!.addEventListener('submit', (e) => {
		e.preventDefault();
		const options = [...results.querySelectorAll<HTMLElement>('[data-iso3]')];
		const picked = options.find((o) => o.getAttribute('aria-selected') === 'true') ?? options[0];
		if (picked) goTo(picked.dataset.iso3!);
	});
</script>

<style>
	/* The flow-field canvas is made by script inside the map, so its style must be global. */
	:global(.flow) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.stage {
		position: relative;
		flex: 1;
		min-height: 420px;
		/* Let the map handle all touch gestures instead of scrolling the page. */
		touch-action: none;
	}
	#map {
		position: absolute;
		inset: 0;
		background: var(--color-ocean);
	}
	.top {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		right: var(--space-2);
		max-width: 20rem;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		/* The hidden intro still takes up room; it must not block dragging the globe. */
		pointer-events: none;
	}
	.search,
	.locate-status,
	.intro {
		pointer-events: auto;
	}
	.search {
		position: relative;
	}
	.search input {
		width: 100%;
		padding-right: 3.25rem;
		min-height: 2.75rem;
		padding: 0 var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text);
		font: inherit;
		font-size: var(--text-base);
	}
	#locate {
		position: absolute;
		top: 0;
		right: 0;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--color-link);
		cursor: pointer;
		transition: background-color 0.15s;
	}
	#locate:hover {
		background: var(--color-surface-raised);
	}
	#locate:active {
		background: var(--color-border);
	}
	#locate:disabled {
		cursor: progress;
		color: var(--color-text-muted);
	}
	#locate svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
	}
	.locate-status {
		margin: 0;
		padding: var(--space-2) var(--space-3);
		font-size: var(--text-sm);
		background: color-mix(in srgb, var(--color-surface) 90%, transparent);
	}
	/* The marker is made by MapLibre, so its style must be global. */
	:global(.you-are-here) {
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--color-link);
		border: 2px solid var(--color-text);
	}
	.search ul {
		position: absolute;
		z-index: 2;
		top: 100%;
		left: 0;
		right: 0;
		margin: var(--space-1) 0 0;
		padding: var(--space-1);
		list-style: none;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.search li {
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		cursor: pointer;
	}
	.search li[aria-selected='true'],
	.search li[data-iso3]:hover {
		background: var(--color-surface-raised);
	}
	.search li.none {
		color: var(--color-text-muted);
		cursor: default;
	}
	.intro {
		padding: var(--space-2) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 85%, transparent);
		backdrop-filter: blur(6px);
		transition: opacity 0.4s;
	}
	.intro.hidden {
		opacity: 0;
		pointer-events: none;
	}
	.intro h1 {
		margin: 0 0 var(--space-1);
		font-size: var(--text-lg);
	}
	.intro p {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.legend {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}
	.swatch {
		flex: none;
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 50%;
		background: var(--color-night);
		border: 1px solid var(--color-land-border);
	}
	/* The zone filter: a small panel that is a closed tab on a phone, so the globe stays clear. */
	.layers {
		position: absolute;
		left: max(var(--space-2), env(safe-area-inset-left));
		/* Clear of MapLibre's attribution bar, which wraps across the bottom of a narrow screen. */
		bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
		max-width: 20rem;
		/* Open, the key is tall; on a short screen it scrolls instead of reaching the intro. */
		max-height: 55%;
		overflow-y: auto;
		padding: 0;
		background: color-mix(in srgb, var(--color-surface) 85%, transparent);
		backdrop-filter: blur(6px);
	}
	.layers summary {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 var(--space-3);
		font-weight: 600;
		cursor: pointer;
	}
	.layers h2 {
		margin: var(--space-2) 0 var(--space-1);
		padding: 0 var(--space-3);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
	}
	.levels {
		list-style: none;
		margin: 0;
		padding: 0 var(--space-3);
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.levels li {
		display: flex;
		gap: var(--space-2);
		margin-bottom: var(--space-2);
	}
	.chip {
		flex: none;
		width: 1rem;
		height: 1rem;
		margin-top: 0.15rem;
		border-radius: 3px;
		border: 1px solid var(--color-land-border);
	}
	.layers p {
		margin: 0;
		padding: 0 var(--space-3) var(--space-2);
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	.layers fieldset {
		margin: 0;
		padding: 0 var(--space-3);
		border: 0;
	}
	.layers label {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		/* A finger-sized row. */
		min-height: 2.75rem;
		font-size: var(--text-sm);
		cursor: pointer;
	}
	.layers input {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		accent-color: var(--color-accent);
	}
	/* A small picture of how each kind is drawn on the map, so the key does not depend on color alone. */
	.key {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
