---
import { render, type CollectionEntry } from 'astro:content';
import Unverified from './Unverified.astro';
import { levelText } from '../lib/restrictiveness';
import { reportErrorUrl } from '../lib/report';
import { linkAttrs } from '../lib/external-link';
import { outline } from '../lib/outline';
import { readFileSync } from 'node:fs';

interface Props {
	country: CollectionEntry<'countries'>;
}

// The full guide for one country. Used by the guide page and by the modal opened from the map.
const { country } = Astro.props;
const { Content } = await render(country);
const d = country.data;
const shape = outline(JSON.parse(readFileSync('public/data/countries.geojson', 'utf8')).features, d.iso3);
// The one thing most visitors came to do. If we have no registration page for the country, go to the authority.
const cta = d.registrationUrl ? { href: d.registrationUrl, label: 'Register online' } : { href: d.authorityUrl, label: 'Go to the official source' };
---

<p class={`level-badge level-${d.restrictiveness}`}><span class="level-number" aria-hidden="true">{d.restrictiveness}</span>{levelText(d.restrictiveness)}</p>
{
	shape && (
		<svg class={`outline level-${d.restrictiveness}`} viewBox={`0 0 ${shape.width} ${shape.height}`} role="img" aria-label={`Outline of ${d.name}`}>
			<path d={shape.d} />
		</svg>
	)
}
<h1>Drone rules in {d.name}</h1>
<p class="muted">Last verified {d.lastVerified.toISOString().slice(0, 10)}</p>
<p class="cta"><a class="button" href={cta.href} {...linkAttrs(cta.href)}>{cta.label}</a></p>
<ul class="quick-facts" aria-label="Quick facts">
	<li><span class="muted">Registration from</span><strong>{d.registrationWeightGrams !== null ? `${d.registrationWeightGrams} g` : <Unverified />}</strong></li>
	<li><span class="muted">Fee</span><strong>{d.registrationFee ?? <Unverified />}</strong></li>
	<li><span class="muted">Minimum age</span><strong>{d.minOperatorAge ?? <Unverified />}</strong></li>
	<li><span class="muted">Remote ID</span><strong>{d.remoteId ?? <Unverified />}</strong></li>
	<li><span class="muted">Insurance</span><strong>{d.insurance ?? <Unverified />}</strong></li>
</ul>
<dl class="card">
	<dt>Authority</dt>
	<dd><a href={d.authorityUrl} {...linkAttrs(d.authorityUrl)}>{d.authority}</a></dd>
	<dt>Rules</dt>
	<dd>{levelText(d.restrictiveness)}. {d.restrictivenessReason}</dd>
	<dt>Who must register</dt>
	<dd>{d.whoMustRegister ?? <Unverified />}</dd>
	<dt>Registration fee</dt>
	<dd>{d.registrationFee ?? <Unverified />}</dd>
	<dt>Registration</dt>
	<dd>{d.registrationUrl ? <a href={d.registrationUrl} {...linkAttrs(d.registrationUrl)}>Register with {d.authority}</a> : <Unverified />}</dd>
	<dt>Lowest registration weight</dt>
	<dd>{d.registrationWeightGrams !== null ? `${d.registrationWeightGrams} g` : <Unverified />}</dd>
	<dt>Minimum operator age</dt>
	<dd>{d.minOperatorAge ?? <Unverified />}</dd>
	<dt>Remote ID</dt>
	<dd>{d.remoteId ?? <Unverified />}</dd>
	<dt>Insurance</dt>
	<dd>{d.insurance ?? <Unverified />}</dd>
</dl>
<section class="how-to">
	<h2>How to register</h2>
	{
		d.howToRegister ? (
			<>
				<h3>Have ready</h3>
				<ul>{d.howToRegister.needed.map((item) => <li>{item}</li>)}</ul>
				<h3>Steps</h3>
				<ol>{d.howToRegister.steps.map((step) => <li>{step}</li>)}</ol>
				<dl class="card">
					<dt>Cost</dt>
					<dd>{d.registrationFee ?? <Unverified />}</dd>
					<dt>Lasts</dt>
					<dd>{d.howToRegister.validFor ?? <Unverified />}</dd>
					<dt>Afterwards</dt>
					<dd>{d.howToRegister.afterwards ?? <Unverified />}</dd>
				</dl>
			</>
		) : (
			<p><Unverified /></p>
		)
	}
</section>
<Content />
<h2>Sources</h2>
<ul>{d.sources.map((url) => <li><a href={url} {...linkAttrs(url)}>{url}</a></li>)}</ul>
<p class="report"><a href={reportErrorUrl(d.name, country.id)} {...linkAttrs(reportErrorUrl(d.name, country.id))}>Report a mistake in this guide</a></p>
<!-- On a phone the button stays at the bottom of the screen while you read, so the action is never far away. -->
<div class="cta-bar"><a class="button" href={cta.href} {...linkAttrs(cta.href)}>{cta.label}</a></div>

<style>
	/* A small silhouette of the country, in its level's color. */
	.outline {
		float: right;
		width: 7rem;
		height: auto;
		margin: 0 0 var(--space-2) var(--space-3);
		fill: var(--level);
		stroke: var(--level);
		stroke-width: 0.5;
		stroke-linejoin: round;
		opacity: 0.9;
	}
	/* The five facts people look for first, in one strip. */
	.quick-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: var(--space-2);
		margin: var(--space-3) 0;
		padding: 0;
		list-style: none;
	}
	.quick-facts li {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		background: var(--color-surface);
		font-size: var(--text-sm);
	}
	.quick-facts strong {
		font-size: var(--text-base);
	}
	.cta {
		margin: var(--space-3) 0;
	}
	.report {
		margin-top: var(--space-4);
	}
	/* Mobile only: pinned to the bottom edge of the screen while the guide is on screen. */
	.cta-bar {
		display: none;
	}
	@media (max-width: 639px) {
		.cta-bar {
			display: block;
			position: sticky;
			bottom: 0;
			margin: var(--space-4) calc(var(--space-3) * -1) calc(var(--space-4) * -1);
			padding: var(--space-2) var(--space-3) max(var(--space-2), env(safe-area-inset-bottom));
			background: var(--color-bg);
		}
		.cta-bar .button {
			display: flex;
			width: 100%;
		}
	}
	dl {
		margin: var(--space-3) 0;
	}
	dt {
		font-weight: 600;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	dd {
		margin: 0 0 var(--space-3);
	}
	dd:last-child {
		margin-bottom: 0;
	}
</style>
