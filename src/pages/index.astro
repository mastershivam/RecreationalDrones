	document.addEventListener('keydown', (e) => {
		const typing = (e.target as Element).closest('input, textarea, select, [contenteditable]');
		if (e.key !== '/' || typing || e.metaKey || e.ctrlKey || e.altKey || dialog.open) return;
		e.preventDefault();
		searchInput.focus();
	});

	// A shared link such as /?country=JPN opens that country straight away.
	const linked = countryFromSearch(location.search, guides);
	if (linked) {
		stopSpin();
		intro.classList.add('hidden');
		map.once('load', () => {
			const camera = bounds[linked] && map.cameraForBounds(bounds[linked], { padding: 60, maxZoom: 5 });
