---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const countries = (await getCollection('countries')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Drone rules by country">
	<div class="prose">
		<h1>Drone rules by country</h1>
		<ul>
			{countries.map((c) => <li><a href={`/countries/${c.id}/`}>{c.data.name}</a></li>)}
		</ul>
	</div>
</Base>

