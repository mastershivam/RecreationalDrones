---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const countries = (await getCollection('countries')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Drone rules by country">
	<div class="prose">
		<h1>Drone rules by country</h1>
		<ul class="countries">
			{
				countries.map((c) => (
					<li class="card">
						<a href={`/countries/${c.id}/`}>{c.data.name}</a>
						<span class="muted">{c.data.authority} · last verified {c.data.lastVerified.toISOString().slice(0, 10)}</span>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.countries {
		list-style: none;
		margin: var(--space-3) 0 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}
	.countries li {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		/* A whole-row target for a finger. */
		padding: var(--space-2) var(--space-3);
	}
	.countries a {
		font-weight: 600;
		font-size: var(--text-lg);
	}
	.countries span {
		font-size: var(--text-sm);
	}
</style>
