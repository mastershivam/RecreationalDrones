---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CountryGuide from '../../components/CountryGuide.astro';
import { guideDescription } from '../../lib/meta';
import { SITE_URL } from '../../lib/site';
import { levelText } from '../../lib/restrictiveness';

export async function getStaticPaths() {
	const countries = await getCollection('countries');
	return countries.map((country) => ({ params: { slug: country.id }, props: { country } }));
}

const { country } = Astro.props;
const d = country.data;
const url = new URL(`/countries/${country.id}/`, SITE_URL).href;
// Search engines show the path (Home > Countries > Japan) and can lift the two plain-fact answers into the result.
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Map', item: new URL('/', SITE_URL).href },
			{ '@type': 'ListItem', position: 2, name: 'Countries', item: new URL('/countries/', SITE_URL).href },
			{ '@type': 'ListItem', position: 3, name: d.name, item: url },
		],
	},
	...(d.whoMustRegister && d.registrationFee
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'FAQPage',
					mainEntity: [
						{ '@type': 'Question', name: `Who must register a drone in ${d.name}?`, acceptedAnswer: { '@type': 'Answer', text: d.whoMustRegister } },
						{ '@type': 'Question', name: `How much does drone registration cost in ${d.name}?`, acceptedAnswer: { '@type': 'Answer', text: d.registrationFee } },
					],
				},
			]
		: []),
];
---

<Base title={`Drone rules in ${d.name}`} description={guideDescription(d)} jsonLd={jsonLd} image={{ path: `/og/${country.id}.png`, alt: `${d.name}: ${levelText(d.restrictiveness)}, a drone rules card from Recreational Drones.` }}>
	<article class="prose">
		<CountryGuide country={country} />
	</article>
</Base>
