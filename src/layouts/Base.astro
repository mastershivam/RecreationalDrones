---
import '../styles/global.css';
import { isCurrent } from '../lib/nav';

interface Props {
	title: string;
	description?: string;
	// Let the page content fill the space between header and footer (the globe).
	fill?: boolean;
}
const { title, description = 'Where and how you can fly a recreational drone, country by country.', fill = false } = Astro.props;
const links = [
	{ href: '/', label: 'Map' },
	{ href: '/countries/', label: 'Countries' },
];
const { pathname } = Astro.url;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0e1a" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Recreational Drones" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header>
			<a class="brand" href="/">Recreational Drones</a>
			<nav>
				{links.map((l) => <a href={l.href} aria-current={isCurrent(pathname, l.href) ? 'page' : undefined}>{l.label}</a>)}
			</nav>
		</header>
		<main id="main" class:list={{ fill }}>
			<slot />
		</main>
		<footer>
			Guidance only, not legal advice. Rules change; always verify with the official source linked on each country
			page before you fly.
		</footer>
	</body>
</html>

<style>
	/* Off screen until a keyboard user tabs to it, then the first thing they see. */
	.skip {
		position: absolute;
		left: var(--space-2);
		top: var(--space-2);
		z-index: 10;
		padding: var(--space-2) var(--space-3);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-radius: var(--radius);
		font-weight: 700;
		transform: translateY(-200%);
	}
	.skip:focus {
		transform: none;
	}
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) max(var(--space-3), env(safe-area-inset-right)) var(--space-2) max(var(--space-3), env(safe-area-inset-left));
		padding-top: max(var(--space-2), env(safe-area-inset-top));
		border-bottom: 1px solid var(--color-border);
	}
	.brand {
		color: var(--color-text);
		font-weight: 700;
		text-decoration: none;
		letter-spacing: 0.02em;
	}
	/* Padding makes each link a comfortable touch target (44px). */
	nav a {
		display: inline-block;
		padding: var(--space-2) var(--space-2);
		margin-left: var(--space-1);
		border-radius: var(--radius);
		transition: background-color 0.15s;
	}
	nav a:hover {
		background: var(--color-surface-raised);
	}
	nav a:active {
		background: var(--color-border);
	}
	/* The page you are on: bolder and in body text color, so it is not marked by color alone. */
	nav a[aria-current='page'] {
		color: var(--color-text);
		font-weight: 700;
	}
	main.fill {
		display: flex;
		flex-direction: column;
	}
	footer {
		padding: var(--space-2) max(var(--space-3), env(safe-area-inset-right)) max(var(--space-2), env(safe-area-inset-bottom)) max(var(--space-3), env(safe-area-inset-left));
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		border-top: 1px solid var(--color-border);
	}
</style>
